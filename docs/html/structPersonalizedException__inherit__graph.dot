digraph "PersonalizedException"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  rankdir="LR";
  Node1 [label="PersonalizedException",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Base class for server exceptions carrying source location metadata."];
  Node2 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="exception",height=0.2,width=0.4,color="grey75", fillcolor="white", style="filled",tooltip=" "];
  Node1 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node3 [label="AlredyLinkedFileDescriptor\lException",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structAlredyLinkedFileDescriptorException.html",tooltip="Indicates that the socket was already bound to an address."];
  Node1 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node4 [label="FileDescriptorIsNotSocket\lException",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structFileDescriptorIsNotSocketException.html",tooltip="Indicates that a file descriptor is not associated with a socket."];
  Node1 -> Node5 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node5 [label="InvalidFileDescriptorException",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structInvalidFileDescriptorException.html",tooltip="Indicates that a system call received an invalid file descriptor."];
  Node1 -> Node6 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node6 [label="NotEnoughFileDescriptors\lException",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structNotEnoughFileDescriptorsException.html",tooltip="Indicates that the process or system has no free file descriptors."];
  Node1 -> Node7 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node7 [label="NotEnoughMemoryException",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structNotEnoughMemoryException.html",tooltip="Indicates that the system lacks memory for the operation."];
  Node1 -> Node8 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node8 [label="NotEnoughPermissionsException",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structNotEnoughPermissionsException.html",tooltip="Indicates that the operation lacks the required permissions."];
  Node1 -> Node9 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node9 [label="PortInUseException",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structPortInUseException.html",tooltip="Indicates that the requested port is already in use."];
  Node1 -> Node10 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node10 [label="SocketNotSupportListenException",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structSocketNotSupportListenException.html",tooltip="Indicates that the socket does not support the listen operation."];
  Node1 -> Node11 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node11 [label="UnknownException",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structUnknownException.html",tooltip="Represents an unclassified server error."];
  Node1 -> Node12 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node12 [label="UnsupportedIPProtocolException",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structUnsupportedIPProtocolException.html",tooltip="Indicates that the requested IP protocol is unsupported."];
}
